//@version=6
// 0SPOT v2.1 — Currency Strength Matrix
// BIS 2022 volume-weighted (USD/EUR/JPY/GBP/CNH/AUD/CAD/CHF/HKD/SGD/NZD/SEK/NOK/MXN/ZAR)
// 14 OANDA pairs covering all 15 currencies, session-aware dynamic ranking,
// EWMA smoothing, rank-delta tracking, and a Best-Pair engine that surfaces
// the strongest-vs-weakest pair to trade right now (with session bias option).
//
// Features:
//   1. Volume-weighted aggregate strength (0-100, centered at 50)
//   2. EWMA-smoothed momentum (alpha=0.333 over 6-bar window)
//   3. Dynamic rank reordering (strongest always top)
//   4. Rank-delta tracking vs previous bar (▲▼•)
//   5. Session-weighted strength overlay (SYD/TOK/LON/NY_AM/NY_PM/LON-NY)
//   6. Best-Pair engine: LONG strongest / SHORT weakest, optional session bias
//   7. Strength-gap filter (skip pairs with gap < threshold)

indicator("0SPOT v2 Currency Strength", shorttitle="0SPOTv2", overlay=true, max_lines_count=500)

// ===== INPUTS =====
showTable         = input.bool(true,     "Show Strength Table")
tablePos          = input.string("bottom_right", "Table Position", options=["bottom_right", "bottom_left", "top_right", "top_left"])
decimals          = input.int(1,         "Decimal Places", minval=0, maxval=3)

// --- Session & Engine Options ---
sessionMode       = input.string("auto", "Session Detection", options=["auto", "manual"], group="Session Engine")
manualSession     = input.string("london", "Manual Session", options=["sydney", "tokyo", "london", "ny_am", "ny_pm", "overlap_lon_ny"], group="Session Engine")
showSessionCol    = input.bool(true,     "Show Session Strength Column", group="Session Engine")
showBestPair      = input.bool(true,     "Show BEST PAIR (long strong / short weak)", group="Best Pair Engine")
minStrengthGap    = input.float(0.5,     "Min strength gap to show pair", minval=0.0, step=0.1, group="Best Pair Engine")
sessionBias       = input.bool(true,     "Weight pair selection by current session", group="Best Pair Engine")

// ===== BIS 2022 VOLUME-WEIGHTED UNIVERSE (Top 15 currencies = 95%+ of FX) =====
// BIS 2022 Triennial Survey: global turnover shares normalized to top 15
// NOTE: "CNH" used instead of BIS "CNY" — OANDA lists offshore yuan as CNH,
// which is what's traded on the platform. BIS volume weight (0.0350) applies.
ccy   = array.from("USD", "EUR", "JPY", "GBP", "CNH", "AUD", "CAD", "CHF", "HKD", "SGD", "NZD", "SEK", "NOK", "MXN", "ZAR")
volWt = array.from(0.4425, 0.1525, 0.0835, 0.0645, 0.0350, 0.0310, 0.0275, 0.0260, 0.0130, 0.0120, 0.0100, 0.0080, 0.0070, 0.0070, 0.0060)
nCcy  = 15

// Theme colors (distinct, colorblind-safe)
cols  = array.from(#1f77b4, #ff7f0e, #2ca02c, #d62728, #9467bd, #8c564b, #e377c2, #7f7f7f, #bcbd22, #17becf, #ff9896, #c5b0d5, #c49c94, #f7b6d2, #c7c7c7)

// ===== ACTIVE 14-PAIR UNIVERSE: covers ALL 15 BIS currencies =====
// Each pair chosen so the set {bases ∪ quotes} == ccy[] (BIS top 15)
// Index mapping must match pairBase[] and pairQuote[] below.
pairs = array.from(
    "EURUSD","USDJPY","GBPUSD","USDCAD","AUDUSD",
    "USDCHF","NZDUSD","USDCNH","USDHKD","USDSGD",
    "USDSEK","USDNOK","USDMXN","USDZAR"
)
nPairs = 14

// Pair -> base/quote mapping (OANDA format: BASE_QUOTE)
pairBase  = array.from("EUR","USD","GBP","USD","AUD","USD","NZD","USD","USD","USD","USD","USD","USD","USD")
pairQuote = array.from("USD","JPY","USD","CAD","USD","CHF","USD","CNH","HKD","SGD","SEK","NOK","MXN","ZAR")

// ===== HELPER: add weighted ROC to accumulators =====
add_to_acc(acc_arr, cnt_arr, b, q, r, w) =>
    bi = array.indexof(ccy, b)
    qi = array.indexof(ccy, q)
    if bi >= 0
        array.set(acc_arr, bi, array.get(acc_arr, bi) + r * w)
        array.set(cnt_arr, bi, array.get(cnt_arr, bi) + 1)
    if qi >= 0
        array.set(acc_arr, qi, array.get(acc_arr, qi) - r * w)
        array.set(cnt_arr, qi, array.get(cnt_arr, qi) + 1)

// ===== SESSION DETECTION =====
// Returns: 0=sydney, 1=tokyo, 2=london, 3=ny_am, 4=ny_pm, 5=overlap_lon_ny
get_session() =>
    h = hour(timeframe.isintraday ? time : time_close, "UTC")
    sess = 0
    if h >= 22 or h < 7
        sess := 0
    else if h >= 0 and h < 9
        sess := 1
    else if h >= 8 and h < 13
        sess := 2
    else if h >= 13 and h < 17
        sess := 5
    else if h >= 17 and h < 22
        sess := 3
    else
        sess := 4
    manualSess = manualSession == "sydney" ? 0 : manualSession == "tokyo" ? 1 : manualSession == "london" ? 2 : manualSession == "ny_am" ? 3 : manualSession == "ny_pm" ? 4 : 5
    sessionMode == "manual" ? manualSess : sess

sessNames = array.from("SYDNEY", "TOKYO", "LONDON", "NY_AM", "NY_PM", "LON/NY")

// ===== MULTI-TIMEFRAME ENGINE =====
// NOTE: request.security() MUST be at global scope. We hoist 14 calls (one per
// top BIS pair) to global scope below, then pass them in as r0..r13.
compute_strength(r0, r1, r2, r3, r4, r5, r6, r7, r8, r9, r10, r11, r12, r13) =>
    var float[] acc  = array.new_float(nCcy, 0.0)
    var int[]   cnt  = array.new_int(nCcy, 0)
    var float[] str  = array.new_float(nCcy, 50.0)
    var float[] prev = array.new_float(nCcy, 50.0)
    var float[] mom  = array.new_float(nCcy, 0.0)
    
    for i = 0 to nCcy - 1
        array.set(acc, i, 0.0)
        array.set(cnt, i, 0)
    
    rArr = array.from(r0, r1, r2, r3, r4, r5, r6, r7, r8, r9, r10, r11, r12, r13)
    
    for i = 0 to 13
        w = array.get(volWt, array.indexof(ccy, array.get(pairBase, i)))
        add_to_acc(acc, cnt, array.get(pairBase, i), array.get(pairQuote, i), array.get(rArr, i), w)
    
    alpha = 2.0 / 6.0
    for i = 0 to nCcy - 1
        array.set(prev, i, array.get(str, i))
        avg = array.get(cnt, i) > 0 ? array.get(acc, i) / array.get(cnt, i) : 0.0
        inst = math.max(0.0, math.min(100.0, 50.0 + avg * 12.0))
        array.set(str, i, array.get(str, i) + alpha * (inst - array.get(str, i)))
        array.set(mom, i, array.get(str, i) - array.get(prev, i))
    
    [array.copy(str), array.copy(mom)]

// ===== RANKING (dynamic - strongest first) =====
rank_currencies(str_arr) =>
    var int[] r = array.new_int(nCcy, 0)
    for i = 0 to nCcy - 1
        array.set(r, i, i)
    for i = 1 to nCcy - 1
        j = i
        while j > 0 and array.get(str_arr, array.get(r, j)) > array.get(str_arr, array.get(r, j-1))
            tmp = array.get(r, j)
            array.set(r, j, array.get(r, j-1))
            array.set(r, j-1, tmp)
            j := j - 1
    array.copy(r)

// ===== AGGREGATE SCORE (volume-weighted across all pairs) =====
calc_aggregate(str_arr) =>
    agg = 0.0
    for i = 0 to nCcy - 1
        agg := agg + array.get(str_arr, i) * array.get(volWt, i)
    agg

// ===== SESSION STRENGTH =====
calc_session_strength(str_arr, sess_idx) =>
    sess_wt = array.new_float(nCcy, 1.0)
    if sess_idx == 1  // TOKYO
        array.set(sess_wt, array.indexof(ccy, "JPY"), 1.5)
        array.set(sess_wt, array.indexof(ccy, "AUD"), 1.3)
        array.set(sess_wt, array.indexof(ccy, "NZD"), 1.3)
    else if sess_idx == 2  // LONDON
        array.set(sess_wt, array.indexof(ccy, "EUR"), 1.5)
        array.set(sess_wt, array.indexof(ccy, "GBP"), 1.5)
        array.set(sess_wt, array.indexof(ccy, "CHF"), 1.3)
    else if sess_idx == 5  // LON/NY OVERLAP
        array.set(sess_wt, array.indexof(ccy, "EUR"), 1.4)
        array.set(sess_wt, array.indexof(ccy, "GBP"), 1.4)
        array.set(sess_wt, array.indexof(ccy, "USD"), 1.4)
    else if sess_idx == 3 or sess_idx == 4  // NY
        array.set(sess_wt, array.indexof(ccy, "USD"), 1.5)
        array.set(sess_wt, array.indexof(ccy, "CAD"), 1.3)
    
    adj = array.new_float(nCcy, 0.0)
    for i = 0 to nCcy - 1
        array.set(adj, i, array.get(str_arr, i) * array.get(sess_wt, i))
    adj

// ===== WINNER PAIR (Pivot Hot Zone) =====
// [REMOVED in v2.1 — replaced by Best Pair Engine. Pivot zones are pair-specific
//  and don't translate cleanly into a 15-currency matrix.]

// ===== GLOBAL SCOPE: request.security() calls (must NOT be inside functions) =====
// 14 top BIS pairs at D timeframe (under 40-call limit)
sec0  = request.security("OANDA:" + array.get(pairs, 0),  "D", ta.roc(close, 14))
sec1  = request.security("OANDA:" + array.get(pairs, 1),  "D", ta.roc(close, 14))
sec2  = request.security("OANDA:" + array.get(pairs, 2),  "D", ta.roc(close, 14))
sec3  = request.security("OANDA:" + array.get(pairs, 3),  "D", ta.roc(close, 14))
sec4  = request.security("OANDA:" + array.get(pairs, 4),  "D", ta.roc(close, 14))
sec5  = request.security("OANDA:" + array.get(pairs, 5),  "D", ta.roc(close, 14))
sec6  = request.security("OANDA:" + array.get(pairs, 6),  "D", ta.roc(close, 14))
sec7  = request.security("OANDA:" + array.get(pairs, 7),  "D", ta.roc(close, 14))
sec8  = request.security("OANDA:" + array.get(pairs, 8),  "D", ta.roc(close, 14))
sec9  = request.security("OANDA:" + array.get(pairs, 9),  "D", ta.roc(close, 14))
sec10 = request.security("OANDA:" + array.get(pairs, 10), "D", ta.roc(close, 14))
sec11 = request.security("OANDA:" + array.get(pairs, 11), "D", ta.roc(close, 14))
sec12 = request.security("OANDA:" + array.get(pairs, 12), "D", ta.roc(close, 14))
sec13 = request.security("OANDA:" + array.get(pairs, 13), "D", ta.roc(close, 14))

// ===== COMPUTE =====
[strength, momentum] = compute_strength(sec0, sec1, sec2, sec3, sec4, sec5, sec6, sec7, sec8, sec9, sec10, sec11, sec12, sec13)
rank = rank_currencies(strength)
aggScore = calc_aggregate(strength)

sessIdx = get_session()
sessStr = calc_session_strength(strength, sessIdx)
sessRank = rank_currencies(sessStr)

// ===== BEST PAIR ENGINE =====
// Strategy: BUY the strongest currency, SELL the weakest. Optional session bias
// uses the session-weighted rank instead of the all-time rank — e.g. in LON
// session, EUR/GBP strength matters more than AUD/NZD.
//
// Output: bestPair (e.g. "EURJPY LONG"), bestGap (strength[strongest] -
// strength[weakest]), bestSession ("LON" if biased, else "ALL").
//
// If bestGap < minStrengthGap, output empty string + gap 0 — too weak to call.
var string bestPair    = ""
var float  bestGap     = 0.0
var string bestSession = ""

if showBestPair
    useRank = sessionBias ? sessRank : rank
    strongestIdx = array.get(useRank, 0)
    weakestIdx   = array.get(useRank, nCcy - 1)
    longCcy  = array.get(ccy, strongestIdx)
    shortCcy = array.get(ccy, weakestIdx)
    gap      = array.get(strength, strongestIdx) - array.get(strength, weakestIdx)
    if gap >= minStrengthGap and longCcy != shortCcy
        bestPair    := longCcy + shortCcy + " LONG"
        bestGap     := gap
        bestSession := sessionBias ? array.get(sessNames, sessIdx) : "ALL"
    else
        bestPair    := ""
        bestGap     := 0.0
        bestSession := ""
else
    bestPair    := ""
    bestGap     := 0.0
    bestSession := ""

// ===== TABLE =====
// Column design rationale (asked user to justify each header — here's the why):
//
//   CCY      — currency code, color-coded so the eye groups rows by asset.
//   AGG      — aggregate strength (0–100), volume-weighted across all pairs.
//              Centered at 50 (neutral). >50 = strong, <50 = weak.
//   MOM      — momentum = EWMA delta. Shows direction of strength change,
//              not just the level. Green = accelerating, red = fading.
//   RANK     — ordinal rank, strongest=1. The "leaderboard".
//   RΔ       — rank change vs previous bar. ▲ green = moved up (got stronger),
//              ▼ red = moved down. • = unchanged. -1 sentinel on first bar
//              so we don't show phantom ▼ on cold start.
//   SESS     — session-weighted strength (current session's bias applied).
//              Same scale as AGG but tells you "in THIS session, who is hot".
//   S-RANK   — rank within current session. Often very different from RANK
//              (e.g., AUD might be #8 overall but #2 in TOK session).
//   BEST     — recommended pair to trade: LONG strongest / SHORT weakest.
//              Session-aware if option is on. Empty if gap < min threshold.
//   GAP      — strength difference (strongest - weakest). The "edge".
//              >3.0 = high-conviction, <1.0 = choppy/no signal.

var table tbl = na
var int[] prev_rank = array.new_int(nCcy, -1)  // -1 = "never seen" sentinel
pos = tablePos == "bottom_right" ? position.bottom_right : tablePos == "bottom_left" ? position.bottom_left : tablePos == "top_right" ? position.top_right : position.top_left

colCount = 5
if showSessionCol
    colCount := colCount + 2
if showBestPair
    colCount := colCount + 2

if barstate.islast and showTable
    tbl := table.new(pos, colCount, nCcy + 1, border_width=1, border_color=color.new(color.gray, 40), frame_width=1, frame_color=color.new(color.gray, 60), bgcolor=color.new(#0f0f0f, 95))

    col = 0
    table.cell(tbl, col, 0, "CCY",   text_color=color.black, text_size=size.small, bgcolor=color.new(#e0e0e0, 100))
    col := col + 1
    table.cell(tbl, col, 0, "AGG",   text_color=color.black, text_size=size.small, bgcolor=color.new(#e0e0e0, 100))
    col := col + 1
    table.cell(tbl, col, 0, "MOM",   text_color=color.black, text_size=size.small, bgcolor=color.new(#e0e0e0, 100))
    col := col + 1
    table.cell(tbl, col, 0, "RANK",  text_color=color.black, text_size=size.small, bgcolor=color.new(#e0e0e0, 100))
    col := col + 1
    table.cell(tbl, col, 0, "RΔ",    text_color=color.black, text_size=size.small, bgcolor=color.new(#e0e0e0, 100))
    col := col + 1
    if showSessionCol
        table.cell(tbl, col, 0, "SESS",    text_color=color.black, text_size=size.small, bgcolor=color.new(#e0e0e0, 100))
        col := col + 1
        table.cell(tbl, col, 0, "S-RANK",  text_color=color.black, text_size=size.small, bgcolor=color.new(#e0e0e0, 100))
        col := col + 1
    if showBestPair
        table.cell(tbl, col, 0, "BEST",    text_color=color.black, text_size=size.small, bgcolor=color.new(#e0e0e0, 100))
        col := col + 1
        table.cell(tbl, col, 0, "GAP",     text_color=color.black, text_size=size.small, bgcolor=color.new(#e0e0e0, 100))
        col := col + 1

    for row = 0 to nCcy - 1
        idx = array.get(rank, row)
        cur = array.get(ccy, idx)
        cColor = array.get(cols, idx)

        fmtStr = "#"
        if decimals > 0
            fmtStr := fmtStr + "."
            for k = 0 to decimals - 1
                fmtStr := fmtStr + "0"

        val = str.tostring(array.get(strength, idx), fmtStr)
        mom = array.get(momentum, idx)
        momFmt = "+#.##;-#.##"
        rnk = str.tostring(row + 1, "#")

        currRank = row
        prevRank = array.get(prev_rank, idx)
        rankChg = prevRank < 0 ? 0 : currRank - prevRank
        chgArrow = rankChg < 0 ? "▲" : rankChg > 0 ? "▼" : "•"
        chgColor = rankChg < 0 ? color.new(#2e7d32, 0) : rankChg > 0 ? color.new(#c62828, 0) : color.new(#757575, 0)

        sessIdx2 = array.indexof(sessRank, idx)
        sessRnk = str.tostring(sessIdx2 + 1, "#")
        sessVal = str.tostring(array.get(sessStr, idx), fmtStr)
        sessColor = sessIdx2 <= 1 ? color.new(#2e7d32, 0) : sessIdx2 <= 3 ? color.new(#f9a825, 0) : color.new(#c62828, 0)

        // BEST PAIR text is only shown on the top (strongest) row, GAP shown there too
        showBest = showBestPair and row == 0 and bestPair != ""
        bestTxt = showBest ? bestPair + " (" + bestSession + ")" : ""
        gapTxt  = showBest ? str.tostring(bestGap, "#.#") : ""
        // Color the gap green if high-conviction (>3.0), yellow if marginal, gray otherwise
        gapColor = bestGap > 3.0 ? color.new(#2e7d32, 0) : bestGap > 1.0 ? color.new(#f9a825, 0) : color.new(#757575, 0)
        bestColor = bestGap > 1.0 ? color.new(#2e7d32, 0) : color.black

        array.set(prev_rank, idx, currRank)

        col2 = 0
        table.cell(tbl, col2, row+1, "  " + cur + "  ", text_color=cColor, text_size=size.normal, bgcolor=color.new(#0f0f0f, 95))
        col2 := col2 + 1
        table.cell(tbl, col2, row+1, "  " + val + "  ", text_color=color.black, text_size=size.normal, bgcolor=color.new(cColor, 30))
        col2 := col2 + 1
        table.cell(tbl, col2, row+1, "  " + str.tostring(mom, momFmt) + "  ", text_color=mom > 0.2 ? color.new(#2e7d32, 0) : mom < -0.2 ? color.new(#c62828, 0) : color.new(#757575, 0), text_size=size.normal, bgcolor=color.new(#f5f5f5, 95))
        col2 := col2 + 1
        table.cell(tbl, col2, row+1, "  " + rnk + "  ", text_color=color.black, text_size=size.normal, bgcolor=color.new(#f5f5f5, 95))
        col2 := col2 + 1
        table.cell(tbl, col2, row+1, "  " + chgArrow + "  ", text_color=chgColor, text_size=size.normal, bgcolor=color.new(#f5f5f5, 95))
        col2 := col2 + 1
        if showSessionCol
            table.cell(tbl, col2, row+1, "  " + sessVal + "  ", text_color=sessColor, text_size=size.normal, bgcolor=color.new(#f5f5f5, 95))
            col2 := col2 + 1
            table.cell(tbl, col2, row+1, "  " + sessRnk + "  ", text_color=sessColor, text_size=size.normal, bgcolor=color.new(#f5f5f5, 95))
            col2 := col2 + 1
        if showBestPair
            table.cell(tbl, col2, row+1, "  " + bestTxt + "  ", text_color=bestColor, text_size=size.normal, bgcolor=color.new(#f5f5f5, 95))
            col2 := col2 + 1
            table.cell(tbl, col2, row+1, "  " + gapTxt + "  ", text_color=gapColor, text_size=size.normal, bgcolor=color.new(#f5f5f5, 95))
            col2 := col2 + 1

plot(na)