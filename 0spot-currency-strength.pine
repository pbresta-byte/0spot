//@version=6
// 0SPOT — Currency Strength Matrix (overlay on main chart)
// 8 majors, 28 OANDA pairs, cumulative 0-100 relative strength
// Color-coded legend bottom-left, lines on price chart for visual snapshot

indicator("0SPOT Currency Strength", shorttitle="0SPOT", overlay=true, max_lines_count=500)

// ===== INPUTS =====
strengthTF    = input.timeframe("D", "Strength Timeframe", options=["D", "W", "M"])
showLegend    = input.bool(true, "Show Legend (bottom-left)")
showCompare   = input.bool(false, "Show Pair Comparison Overlays")

// ===== 8 MAJORS =====
ccy   = array.from("EUR", "USD", "GBP", "JPY", "AUD", "NZD", "CAD", "CHF")
cols  = array.from(#2196f3, #4caf50, #ffeb3b, #f44336, #ff9800, #8bc34a, #ff5722, #00bcd4)

// ===== ACCUMULATORS =====
acc = array.new_float(8, 0.0)
cnt = array.new_int(8, 0)

f_add(b, q, r) =>
    bi = array.indexof(ccy, b)
    qi = array.indexof(ccy, q)
    if bi >= 0
        array.set(acc, bi, array.get(acc, bi) + r)
        array.set(cnt, bi, array.get(cnt, bi) + 1)
    if qi >= 0
        array.set(acc, qi, array.get(acc, qi) - r)
        array.set(cnt, qi, array.get(cnt, qi) + 1)

// ===== ROC ENGINE (all 28 at global scope — fixes CW10003) =====
r0  = request.security("OANDA:EUR_USD",  strengthTF, ta.roc(close, 14))
r1  = request.security("OANDA:EUR_GBP",  strengthTF, ta.roc(close, 14))
r2  = request.security("OANDA:EUR_JPY",  strengthTF, ta.roc(close, 14))
r3  = request.security("OANDA:EUR_AUD",  strengthTF, ta.roc(close, 14))
r4  = request.security("OANDA:EUR_NZD",  strengthTF, ta.roc(close, 14))
r5  = request.security("OANDA:EUR_CAD",  strengthTF, ta.roc(close, 14))
r6  = request.security("OANDA:EUR_CHF",  strengthTF, ta.roc(close, 14))
r7  = request.security("OANDA:GBP_USD",  strengthTF, ta.roc(close, 14))
r8  = request.security("OANDA:GBP_JPY",  strengthTF, ta.roc(close, 14))
r9  = request.security("OANDA:GBP_AUD",  strengthTF, ta.roc(close, 14))
r10 = request.security("OANDA:GBP_NZD",  strengthTF, ta.roc(close, 14))
r11 = request.security("OANDA:GBP_CAD",  strengthTF, ta.roc(close, 14))
r12 = request.security("OANDA:GBP_CHF",  strengthTF, ta.roc(close, 14))
r13 = request.security("OANDA:USD_JPY",  strengthTF, ta.roc(close, 14))
r14 = request.security("OANDA:USD_CHF",  strengthTF, ta.roc(close, 14))
r15 = request.security("OANDA:USD_CAD",  strengthTF, ta.roc(close, 14))
r16 = request.security("OANDA:AUD_USD",  strengthTF, ta.roc(close, 14))
r17 = request.security("OANDA:AUD_JPY",  strengthTF, ta.roc(close, 14))
r18 = request.security("OANDA:AUD_CAD",  strengthTF, ta.roc(close, 14))
r19 = request.security("OANDA:AUD_CHF",  strengthTF, ta.roc(close, 14))
r20 = request.security("OANDA:AUD_NZD",  strengthTF, ta.roc(close, 14))
r21 = request.security("OANDA:NZD_USD",  strengthTF, ta.roc(close, 14))
r22 = request.security("OANDA:NZD_JPY",  strengthTF, ta.roc(close, 14))
r23 = request.security("OANDA:NZD_CAD",  strengthTF, ta.roc(close, 14))
r24 = request.security("OANDA:NZD_CHF",  strengthTF, ta.roc(close, 14))
r25 = request.security("OANDA:CAD_JPY",  strengthTF, ta.roc(close, 14))
r26 = request.security("OANDA:CAD_CHF",  strengthTF, ta.roc(close, 14))
r27 = request.security("OANDA:CHF_JPY",  strengthTF, ta.roc(close, 14))

// Feed accumulators (global scope — fixes CE10005)
f_add("EUR", "USD", r0)
f_add("EUR", "GBP", r1)
f_add("EUR", "JPY", r2)
f_add("EUR", "AUD", r3)
f_add("EUR", "NZD", r4)
f_add("EUR", "CAD", r5)
f_add("EUR", "CHF", r6)
f_add("GBP", "USD", r7)
f_add("GBP", "JPY", r8)
f_add("GBP", "AUD", r9)
f_add("GBP", "NZD", r10)
f_add("GBP", "CAD", r11)
f_add("GBP", "CHF", r12)
f_add("USD", "JPY", r13)
f_add("USD", "CHF", r14)
f_add("USD", "CAD", r15)
f_add("AUD", "USD", r16)
f_add("AUD", "JPY", r17)
f_add("AUD", "CAD", r18)
f_add("AUD", "CHF", r19)
f_add("AUD", "NZD", r20)
f_add("NZD", "USD", r21)
f_add("NZD", "JPY", r22)
f_add("NZD", "CAD", r23)
f_add("NZD", "CHF", r24)
f_add("CAD", "JPY", r25)
f_add("CAD", "CHF", r26)
f_add("CHF", "JPY", r27)

// ===== NORMALIZE 0-100 (EMA smoothed, centered at 50) =====
var float[] strength = array.new_float(8, 50.0)
alpha = 2.0 / 6.0
for i = 0 to 7
    avg = cnt.get(i) > 0 ? acc.get(i) / cnt.get(i) : 0.0
    inst = math.max(0.0, math.min(100.0, 50.0 + avg * 12.0))
    array.set(strength, i, array.get(strength, i) + alpha * (inst - array.get(strength, i)))

// ===== RELATIVE TO CHART'S QUOTE CURRENCY =====
chartPair = str.replace_all(syminfo.ticker, "OANDA:", "")
baseC = syminfo.basecurrency
quoteC = str.replace_all(chartPair, baseC + "_", "")
qIdx   = array.indexof(ccy, quoteC)
relQuote = qIdx >= 0 ? array.get(strength, qIdx) : 50.0

// ===== PLOT 8 STRENGTH LINES ON CHART =====
priceHi = high
priceLo = low
priceRg = priceHi - priceLo
midPx   = (priceHi + priceLo) / 2.0

plot_eur = midPx + ((array.get(strength, 0) - relQuote + 50.0) - 50.0) / 50.0 * priceRg * 0.8
plot_usd = midPx + ((array.get(strength, 1) - relQuote + 50.0) - 50.0) / 50.0 * priceRg * 0.8
plot_gbp = midPx + ((array.get(strength, 2) - relQuote + 50.0) - 50.0) / 50.0 * priceRg * 0.8
plot_jpy = midPx + ((array.get(strength, 3) - relQuote + 50.0) - 50.0) / 50.0 * priceRg * 0.8
plot_aud = midPx + ((array.get(strength, 4) - relQuote + 50.0) - 50.0) / 50.0 * priceRg * 0.8
plot_nzd = midPx + ((array.get(strength, 5) - relQuote + 50.0) - 50.0) / 50.0 * priceRg * 0.8
plot_cad = midPx + ((array.get(strength, 6) - relQuote + 50.0) - 50.0) / 50.0 * priceRg * 0.8
plot_chf = midPx + ((array.get(strength, 7) - relQuote + 50.0) - 50.0) / 50.0 * priceRg * 0.8

plot(plot_eur, "EUR", color=#2196f3, linewidth=2, style=plot.style_linebr)
plot(plot_usd, "USD", color=#4caf50, linewidth=2, style=plot.style_linebr)
plot(plot_gbp, "GBP", color=#ffeb3b, linewidth=2, style=plot.style_linebr)
plot(plot_jpy, "JPY", color=#f44336, linewidth=2, style=plot.style_linebr)
plot(plot_aud, "AUD", color=#ff9800, linewidth=2, style=plot.style_linebr)
plot(plot_nzd, "NZD", color=#8bc34a, linewidth=2, style=plot.style_linebr)
plot(plot_cad, "CAD", color=#ff5722, linewidth=2, style=plot.style_linebr)
plot(plot_chf, "CHF", color=#00bcd4, linewidth=2, style=plot.style_linebr)

// ===== PAIR COMPARISON OVERLAYS (all global scope — fixes CW10003) =====
plot_gbpusd = request.security("OANDA:GBP_USD", "D", close)
plot_usdjpy = request.security("OANDA:USD_JPY", "D", close)
plot_audusd = request.security("OANDA:AUD_USD", "D", close)
plot_nzdusd = request.security("OANDA:NZD_USD", "D", close)
plot_usdcad = request.security("OANDA:USD_CAD", "D", close)
plot_usdchf = request.security("OANDA:USD_CHF", "D", close)
plot_eurusd = request.security("OANDA:EUR_USD", "D", close)
plot_eurjpy = request.security("OANDA:EUR_JPY", "D", close)

plot(showCompare ? plot_gbpusd : na, "GBP/USD", color=#ffeb3b, linewidth=1, style=plot.style_circles)
plot(showCompare ? plot_usdjpy : na, "USD/JPY", color=#f44336, linewidth=1, style=plot.style_circles)
plot(showCompare ? plot_audusd : na, "AUD/USD", color=#ff9800, linewidth=1, style=plot.style_circles)
plot(showCompare ? plot_nzdusd : na, "NZD/USD", color=#8bc34a, linewidth=1, style=plot.style_circles)
plot(showCompare ? plot_usdcad : na, "USD/CAD", color=#ff5722, linewidth=1, style=plot.style_circles)
plot(showCompare ? plot_usdchf : na, "USD/CHF", color=#00bcd4, linewidth=1, style=plot.style_circles)
plot(showCompare ? plot_eurusd : na, "EUR/USD", color=#2196f3, linewidth=1, style=plot.style_circles)
plot(showCompare ? plot_eurjpy : na, "EUR/JPY", color=#f44336, linewidth=1, style=plot.style_circles)

// ===== LEGEND TABLE (bottom-left) =====
var table leg = table.new(position.bottom_left, 2, 9, border_width=1, border_color=color.new(color.black, 50), frame_width=1, frame_color=color.new(color.black, 50))

if barstate.islast and showLegend
    table.cell(leg, 0, 0, "0SPOT", text_color=color.white, text_size=size.small, bgcolor=color.new(#1e1e1e, 90))
    table.cell(leg, 1, 0, "Strength", text_color=color.white, text_size=size.small, bgcolor=color.new(#1e1e1e, 90))
    for i = 0 to 7
        c = array.get(ccy, i)
        cColor = array.get(cols, i)
        val = array.get(strength, i) - relQuote + 50.0
        table.cell(leg, 0, i+1, "  " + c + "  ", text_color=cColor, text_size=size.normal, bgcolor=color.new(#1e1e1e, 90))
        table.cell(leg, 1, i+1, str.tostring(val, "#.#"), text_color=color.white, text_size=size.small, bgcolor=color.new(#1e1e1e, 90))