//@version=6
// 0SPOT — Currency Strength Matrix (multi-timeframe numerical aggregate)
// 8 majors, 28 OANDA pairs, 0-100 relative strength across D/W/M
// Rectangular table bottom-right, black text values, color-coded currency labels

indicator("0SPOT Currency Strength", shorttitle="0SPOT", overlay=true, max_lines_count=500)

// ===== INPUTS =====
showTable     = input.bool(true, "Show Strength Table")
tablePos      = input.string("bottom_right", "Table Position", options=["bottom_right", "bottom_left", "top_right", "top_left"])
decimals      = input.int(1, "Decimal Places", minval=0, maxval=3)

// ===== 8 MAJORS =====
ccy   = array.from("EUR", "USD", "GBP", "JPY", "AUD", "NZD", "CAD", "CHF")
cols  = array.from(#2196f3, #4caf50, #ffeb3b, #f44336, #ff9800, #8bc34a, #ff5722, #00bcd4)

// ===== PAIRS (28) - no underscores for OANDA format =====
pairs = array.from(
    "EURUSD","EURGBP","EURJPY","EURAUD","EURNZD","EURCAD","EURCHF",
    "GBPUSD","GBPJPY","GBPAUD","GBPNZD","GBPCAD","GBPCHF",
    "USDJPY","USDCHF","USDCAD",
    "AUDUSD","AUDJPY","AUDCAD","AUDCHF","AUDNZD",
    "NZDUSD","NZDJPY","NZDCAD","NZDCHF",
    "CADJPY","CADCHF","CHFJPY")

// ===== HELPER: add ROC to accumulators =====
add_to_acc(acc_arr, cnt_arr, b, q, r) =>
    bi = array.indexof(ccy, b)
    qi = array.indexof(ccy, q)
    if bi >= 0
        array.set(acc_arr, bi, array.get(acc_arr, bi) + r)
        array.set(cnt_arr, bi, array.get(cnt_arr, bi) + 1)
    if qi >= 0
        array.set(acc_arr, qi, array.get(acc_arr, qi) - r)
        array.set(cnt_arr, qi, array.get(cnt_arr, qi) + 1)

// ===== MULTI-TIMEFRAME ENGINE =====
// Returns array of 8 strength values for given timeframe
compute_strength(tf) =>
    var float[] acc_tf = array.new_float(8, 0.0)
    var int[]   cnt_tf = array.new_int(8, 0)
    
    // Reset accumulators each bar
    for i = 0 to 7
        array.set(acc_tf, i, 0.0)
        array.set(cnt_tf, i, 0)
    
    // 28 ROC calls at global scope via request.security
    r0  = request.security("OANDA:EURUSD",  tf, ta.roc(close, 14))
    r1  = request.security("OANDA:EURGBP",  tf, ta.roc(close, 14))
    r2  = request.security("OANDA:EURJPY",  tf, ta.roc(close, 14))
    r3  = request.security("OANDA:EURAUD",  tf, ta.roc(close, 14))
    r4  = request.security("OANDA:EURNZD",  tf, ta.roc(close, 14))
    r5  = request.security("OANDA:EURCAD",  tf, ta.roc(close, 14))
    r6  = request.security("OANDA:EURCHF",  tf, ta.roc(close, 14))
    r7  = request.security("OANDA:GBPUSD",  tf, ta.roc(close, 14))
    r8  = request.security("OANDA:GBPJPY",  tf, ta.roc(close, 14))
    r9  = request.security("OANDA:GBPAUD",  tf, ta.roc(close, 14))
    r10 = request.security("OANDA:GBPNZD",  tf, ta.roc(close, 14))
    r11 = request.security("OANDA:GBPCAD",  tf, ta.roc(close, 14))
    r12 = request.security("OANDA:GBPCHF",  tf, ta.roc(close, 14))
    r13 = request.security("OANDA:USDJPY",  tf, ta.roc(close, 14))
    r14 = request.security("OANDA:USDCHF",  tf, ta.roc(close, 14))
    r15 = request.security("OANDA:USDCAD",  tf, ta.roc(close, 14))
    r16 = request.security("OANDA:AUDUSD",  tf, ta.roc(close, 14))
    r17 = request.security("OANDA:AUDJPY",  tf, ta.roc(close, 14))
    r18 = request.security("OANDA:AUDCAD",  tf, ta.roc(close, 14))
    r19 = request.security("OANDA:AUDCHF",  tf, ta.roc(close, 14))
    r20 = request.security("OANDA:AUDNZD",  tf, ta.roc(close, 14))
    r21 = request.security("OANDA:NZDUSD",  tf, ta.roc(close, 14))
    r22 = request.security("OANDA:NZDJPY",  tf, ta.roc(close, 14))
    r23 = request.security("OANDA:NZDCAD",  tf, ta.roc(close, 14))
    r24 = request.security("OANDA:NZDCHF",  tf, ta.roc(close, 14))
    r25 = request.security("OANDA:CADJPY",  tf, ta.roc(close, 14))
    r26 = request.security("OANDA:CADCHF",  tf, ta.roc(close, 14))
    r27 = request.security("OANDA:CHFJPY",  tf, ta.roc(close, 14))
    
    add_to_acc(acc_tf, cnt_tf, "EUR", "USD", r0)
    add_to_acc(acc_tf, cnt_tf, "EUR", "GBP", r1)
    add_to_acc(acc_tf, cnt_tf, "EUR", "JPY", r2)
    add_to_acc(acc_tf, cnt_tf, "EUR", "AUD", r3)
    add_to_acc(acc_tf, cnt_tf, "EUR", "NZD", r4)
    add_to_acc(acc_tf, cnt_tf, "EUR", "CAD", r5)
    add_to_acc(acc_tf, cnt_tf, "EUR", "CHF", r6)
    add_to_acc(acc_tf, cnt_tf, "GBP", "USD", r7)
    add_to_acc(acc_tf, cnt_tf, "GBP", "JPY", r8)
    add_to_acc(acc_tf, cnt_tf, "GBP", "AUD", r9)
    add_to_acc(acc_tf, cnt_tf, "GBP", "NZD", r10)
    add_to_acc(acc_tf, cnt_tf, "GBP", "CAD", r11)
    add_to_acc(acc_tf, cnt_tf, "GBP", "CHF", r12)
    add_to_acc(acc_tf, cnt_tf, "USD", "JPY", r13)
    add_to_acc(acc_tf, cnt_tf, "USD", "CHF", r14)
    add_to_acc(acc_tf, cnt_tf, "USD", "CAD", r15)
    add_to_acc(acc_tf, cnt_tf, "AUD", "USD", r16)
    add_to_acc(acc_tf, cnt_tf, "AUD", "JPY", r17)
    add_to_acc(acc_tf, cnt_tf, "AUD", "CAD", r18)
    add_to_acc(acc_tf, cnt_tf, "AUD", "CHF", r19)
    add_to_acc(acc_tf, cnt_tf, "AUD", "NZD", r20)
    add_to_acc(acc_tf, cnt_tf, "NZD", "USD", r21)
    add_to_acc(acc_tf, cnt_tf, "NZD", "JPY", r22)
    add_to_acc(acc_tf, cnt_tf, "NZD", "CAD", r23)
    add_to_acc(acc_tf, cnt_tf, "NZD", "CHF", r24)
    add_to_acc(acc_tf, cnt_tf, "CAD", "JPY", r25)
    add_to_acc(acc_tf, cnt_tf, "CAD", "CHF", r26)
    add_to_acc(acc_tf, cnt_tf, "CHF", "JPY", r27)
    
    // Normalize 0-100
    var float[] strength_tf = array.new_float(8, 50.0)
    alpha = 2.0 / 6.0
    for i = 0 to 7
        avg = array.get(cnt_tf, i) > 0 ? array.get(acc_tf, i) / array.get(cnt_tf, i) : 0.0
        inst = math.max(0.0, math.min(100.0, 50.0 + avg * 12.0))
        array.set(strength_tf, i, array.get(strength_tf, i) + alpha * (inst - array.get(strength_tf, i)))
    
    array.copy(strength_tf)

// ===== RANKING =====
rank_currencies(str_arr) =>
    var int[] r = array.new_int(8, 0)
    for i = 0 to 7
        array.set(r, i, i)
    for i = 1 to 7
        j = i
        while j > 0 and array.get(str_arr, array.get(r, j)) > array.get(str_arr, array.get(r, j-1))
            tmp = array.get(r, j)
            array.set(r, j, array.get(r, j-1))
            array.set(r, j-1, tmp)
            j := j - 1
    array.copy(r)

// Compute for D, W, M
strength_D = compute_strength("D")
strength_W = compute_strength("W")
strength_M = compute_strength("M")

rank_D = rank_currencies(strength_D)
rank_W = rank_currencies(strength_W)
rank_M = rank_currencies(strength_M)

// ===== TABLE (rectangular, bottom-right) =====
var table tbl = na
pos = tablePos == "bottom_right" ? position.bottom_right : tablePos == "bottom_left" ? position.bottom_left : tablePos == "top_right" ? position.top_right : position.top_left

if barstate.islast and showTable
    tbl := table.new(pos, 5, 10, border_width=1, border_color=color.new(color.gray, 40), frame_width=1, frame_color=color.new(color.gray, 60), bgcolor=color.new(#0f0f0f, 95))
    
    // Header
    table.cell(tbl, 0, 0, "CCY", text_color=color.white, text_size=size.small, bgcolor=color.new(#1a1a1a, 100))
    table.cell(tbl, 1, 0, "DAILY", text_color=color.white, text_size=size.small, bgcolor=color.new(#1a1a1a, 100))
    table.cell(tbl, 2, 0, "WEEKLY", text_color=color.white, text_size=size.small, bgcolor=color.new(#1a1a1a, 100))
    table.cell(tbl, 3, 0, "MONTHLY", text_color=color.white, text_size=size.small, bgcolor=color.new(#1a1a1a, 100))
    table.cell(tbl, 4, 0, "AVG RANK", text_color=color.white, text_size=size.small, bgcolor=color.new(#1a1a1a, 100))
    
    for row = 0 to 7
        idx = array.get(rank_D, row)
        c   = array.get(ccy, idx)
        cColor = array.get(cols, idx)
        
        // Format string
        fmtStr = "#"
        if decimals > 0
            fmtStr := fmtStr + "."
            for k = 0 to decimals - 1
                fmtStr := fmtStr + "0"
        
        valD = str.tostring(array.get(strength_D, idx), fmtStr)
        valW = str.tostring(array.get(strength_W, idx), fmtStr)
        valM = str.tostring(array.get(strength_M, idx), fmtStr)
        
        // Average rank across timeframes
        rD = array.indexof(rank_D, idx) + 1
        rW = array.indexof(rank_W, idx) + 1
        rM = array.indexof(rank_M, idx) + 1
        avgR = str.tostring((rD + rW + rM) / 3.0, "#.#")
        
        // Currency label (color-coded)
        table.cell(tbl, 0, row+1, "  " + c + "  ", text_color=cColor, text_size=size.normal, bgcolor=color.new(#0f0f0f, 95))
        // Daily (black text on colored bg)
        table.cell(tbl, 1, row+1, "  " + valD + "  ", text_color=color.black, text_size=size.normal, bgcolor=color.new(cColor, 30))
        // Weekly
        table.cell(tbl, 2, row+1, "  " + valW + "  ", text_color=color.black, text_size=size.normal, bgcolor=color.new(cColor, 30))
        // Monthly
        table.cell(tbl, 3, row+1, "  " + valM + "  ", text_color=color.black, text_size=size.normal, bgcolor=color.new(cColor, 30))
        // Avg rank
        table.cell(tbl, 4, row+1, "  " + avgR + "  ", text_color=color.white, text_size=size.normal, bgcolor=color.new(#0f0f0f, 95))

// Clean chart (no plots)
plot(na)